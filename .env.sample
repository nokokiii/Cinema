# ==========================================
# Cinema - Environment Variables Configuration
# Copy this file to `.env.local` (or `.env`) and fill in your values:
#   cp .env.sample .env.local
# ==========================================

# Full connection string for MongoDB (MongoDB Atlas or local instance)
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# Local example: mongodb://localhost:27017/cinema
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>"

# Database name (optional, defaults to "cinema")
MONGODB_DB_NAME="cinema"

# Reservation timeout in minutes (defaults to 15, set to 2 for automated testing)
RESERVATION_TIMEOUT_MINUTES=15

# Disables per-IP API rate limiting (set to "true" only for local integration test runs)
RATE_LIMIT_DISABLED=false

# Stripe configuration for future checkout / payment integration
# Example: sk_test_... or sk_live_...
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Ticket price in the smallest currency unit, e.g. 3000 = 30.00 PLN
STRIPE_TICKET_PRICE_MINOR=3000
# 3-letter ISO currency code
STRIPE_CURRENCY="pln"

# Optional MongoDB credentials (e.g. from Atlas onboarding)
MONGODB_USERNAME=""
MONGODB_PASSWORD=""

# Etap III: Voucherify loyalty points (legacy v1 campaign API). Leave unset to use the
# built-in in-memory/Mongo fallback loyalty store with the same documented behaviour.
VOUCHERIFY_APPLICATION_ID=""
VOUCHERIFY_SECRET_KEY=""
VOUCHERIFY_CAMPAIGN_ID=""

# Etap III: Resend transactional email for purchase confirmations. Without a verified
# domain, Resend only delivers from onboarding@resend.dev to the account owner's address
# and to published test addresses (delivered@resend.dev, bounced@resend.dev, +label works).
RESEND_API_KEY=""

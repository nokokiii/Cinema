# ==========================================
# Cinema - Environment Variables Configuration
# Copy this file to `.env.local` (or `.env`) and fill in your values:
#   cp .env.sample .env.local
# ==========================================

# Full connection string for MongoDB (MongoDB Atlas or local instance)
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# Local example: mongodb://localhost:27017/cinema
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>"

# Database name (optional, defaults to "cinema")
MONGODB_DB_NAME="cinema"

# Reservation timeout in minutes (defaults to 15, set to 2 for automated testing)
RESERVATION_TIMEOUT_MINUTES=15

# Optional MongoDB credentials (e.g. from Atlas onboarding)
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
